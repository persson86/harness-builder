{
  "autoCompactWindow": 300000,
  "statusLine": {
    "type": "command",
    "command": "$CLAUDE_PROJECT_DIR/statusline-command.sh"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-quality-gates.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
